{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":rebaseStalePrs",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone"
  ],
  "labels": [
    "dependencies",
    "security"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "@nestjs/*",
        "nestjs-*"
      ],
      "groupName": "NestJS framework"
    },
    {
      "matchPackageNames": [
        "@prisma/*",
        "prisma"
      ],
      "groupName": "Prisma ORM"
    },
    {
      "matchPackageNames": [
        "@opentelemetry/*"
      ],
      "groupName": "OpenTelemetry SDK"
    },
    {
      "matchPackageNames": [
        "@google-cloud/*"
      ],
      "groupName": "Google Cloud SDKs"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "platformAutomerge": true
    }
  ]
}
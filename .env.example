# Server Configuration
PORT=3000

# CORS Configuration
# ALLOWED_ORIGINS=*
# ALLOWED_ORIGINS=http://localhost:3000,http://app.meudominio.com

# Rate Limiting Configuration
THROTTLE_TTL=60000
THROTTLE_LIMIT=10
THROTTLE_LIMIT_AUTHENTICATED=500

# GCP Configuration
GCP_PRIMARY_PROJECT_ID=
GCP_PROJECT_A_ID=
GCP_PROJECT_B_ID=
PUBSUB_ENABLED=false
BIGQUERY_ENABLED=false
STORAGE_ENABLED=false

# Database Configuration (Bitnami Postgres)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# Prisma Connection
DATABASE_URL=
# SHADOW_DATABASE_URL= # Opcional: Necessário apenas para Migrate em DBs de Cloud restritos

DATABASE_URL_PRIMARY=
DATABASE_URL_SECONDARY=

# Security
JWT_SECRET=my-super-secret-jwt-key-for-local-dev-123
AUTH_ROLES_CLAIM_PATH=roles
AUTH_PERMISSIONS_CLAIM_PATH=permissions

# OpenTelemetry Configuration
OTEL_SERVICE_NAME=nest-template
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Collector External Exporters
JAEGER_URL=jaeger:4317
PROMETHEUS_ENDPOINT=0.0.0.0:8889
LOKI_OTLP_ENDPOINT=http://loki:3100/otlp
DD_URL=datadoghq.com
DD_KEY=

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_ENABLED=false
CACHE_DEFAULT_TTL=60

# Grafana Configuration
GRAFANA_PORT=3090
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Admin
GF_AUTH_DISABLE_LOGIN_FORM=false
LOKI_URL=http://loki:3100
JAEGER_UI_URL=http://jaeger:16686
PROMETHEUS_URL=http://prometheus:9090


